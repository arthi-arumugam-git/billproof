{
  "name": "billproof",
  "version": "0.2.1",
  "description": "Prove your AI bill. Prices every Claude Code, Codex and Gemini CLI request the way the provider bills it, shows which turns cost the money and why, and reconciles an organisation's Anthropic invoice against its own records.",
  "type": "module",
  "bin": {
    "billproof": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cost",
    "tokens",
    "prompt-caching",
    "billing",
    "usage",
    "codex",
    "gemini",
    "openai",
    "reconcile",
    "admin-api"
  ],
  "author": "Arthi Arumugam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arthi-arumugam-git/billproof"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
